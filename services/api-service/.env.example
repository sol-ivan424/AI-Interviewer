APP_NAME=AI Interviewer API
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interviewer
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERVIEW_QUESTIONS_COUNT=15
INTERVIEW_SEED_QUESTIONS_COUNT=5

LLM_PROVIDER=ollama
LLM_SERVICE_URL=http://localhost:8001
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1800
SCORING_FALLBACK_ENABLED=true

ML_SERVICE_URL=http://localhost:8002
ML_TIMEOUT_SECONDS=3

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
